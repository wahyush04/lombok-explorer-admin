# Canonical Admin API base URL (Remote API)
NEXT_PUBLIC_API_BASE_URL=http://34.142.205.101:3000/api/v1/admin
VITE_API_BASE_URL=http://34.142.205.101:3000/api/v1/admin

# Server Port mapping for Docker/Host (Default: 3001 to prevent conflict with backend on 3000)
PORT=3001

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Mapbox Public Token (for interactive map location picker)
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

